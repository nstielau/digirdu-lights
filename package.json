{
  "name": "digirdu-dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node tools/build_web.mjs",
    "test": "node --test web/test/*.test.mjs",
    "test:browser": "playwright test",
    "test:emulator": "firebase emulators:exec --project demo-digirdu --only firestore 'npm --prefix firebase/functions run test:emulator'"
  },
  "dependencies": {
    "firebase": "12.19.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "@playwright/test": "1.63.0",
    "node": "22.23.2"
  }
}
